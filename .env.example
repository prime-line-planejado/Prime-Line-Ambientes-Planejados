# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://primelineplanejados.com.br

# ─── WhatsApp ────────────────────────────────────────────────────────────────
# Número no formato internacional sem + ou espaços (DDI + DDD + número)
NEXT_PUBLIC_WHATSAPP_NUMBER=5531998156666

# ─── Contato / Formulário ────────────────────────────────────────────────────
NEXT_PUBLIC_EMAIL=contato@primelineplanejados.com.br
# Chave pública do Web3Forms (https://web3forms.com)
NEXT_PUBLIC_WEB3FORMS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Analytics ───────────────────────────────────────────────────────────────
# ID do Google Analytics 4 (ex: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── Google Maps ─────────────────────────────────────────────────────────────
# URL do perfil no Google Maps (usado em botões "Ver no Maps" e sameAs schema)
NEXT_PUBLIC_GOOGLE_MAPS_PROFILE=https://www.google.com/maps/place/Prime+Line+Ambientes+Planejados/data=!4m2!3m1!1s0x0:0x15e7086bbff5046b
# URL que abre direto no painel de avaliações do Google
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://www.google.com/maps/place/Prime+Line+Ambientes+Planejados/@-19.9543,-43.9777,17z/data=!3m1!4b1!4m6!3m5!1s0x0:0x15e7086bbff5046b
# URL do embed do Maps para o iframe na página de contato
NEXT_PUBLIC_GOOGLE_MAPS_EMBED=https://maps.google.com/maps?q=-19.9543,-43.9777&z=16&output=embed

# ─── Redes Sociais (opcional — deixe vazio para não exibir no footer) ────────
NEXT_PUBLIC_INSTAGRAM=@primeline_planejados
NEXT_PUBLIC_PINTEREST=
NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_YOUTUBE=

# ─── Supabase (servidor — NÃO expor no frontend) ─────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Resend (e-mail de leads — servidor) ────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Admin ───────────────────────────────────────────────────────────────────
# Senha de acesso ao painel /admin/leads
ADMIN_LEADS_PASSWORD=SUA_SENHA_SEGURA_AQUI
